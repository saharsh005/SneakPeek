# SneakPeek environment template
# Copy to .env and fill in your real values.

# Camera
CAM_STREAM_URL=http://10.224.162.150/stream

# Flask
PORT=5000
FLASK_DEBUG=false

# Email
EMAIL_PROVIDER=smtp
SMTP_FROM=your_email@gmail.com
AWS_SES_RECIPIENT=receiver@email.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_USE_TLS=true

# AI / vision
YOLO_POSE_MODEL=yolov8n-pose.pt
YOLO_DETECT_MODEL=yolov8n.pt
FACE_TOLERANCE=0.5

# Local files
CUSTOM_THREATS_PATH=./custom_threats.json
ALERT_COOLDOWN_S=60
